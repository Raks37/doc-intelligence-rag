# Copy to .env and adjust. .env is git-ignored.

# ---------------------------------------------------------------------------
# LLM backend
# ---------------------------------------------------------------------------
# local | anthropic | openai | bedrock
LLM_PROVIDER=local

# --- local provider (llama-cpp-python, runs in-process, no API key) ---------
LLM_MODEL_PATH=C:\path\to\phi-2.Q4_K_M.gguf
LLM_N_CTX=2048
# LLM_MAX_TOKENS=512

# --- anthropic (optional: pip install langchain-anthropic) -----------------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-4-6

# --- openai / LM Studio / Ollama (optional: pip install langchain-openai) ---
# LLM_PROVIDER=openai
# OPENAI_API_KEY=lm-studio            # any non-empty value for local servers
# OPENAI_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=gemma-3-12b-it

# ---------------------------------------------------------------------------
# Kafka (off by default; events are logged as [KAFKA-SIMULATED])
# ---------------------------------------------------------------------------
KAFKA_ENABLED=false
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
